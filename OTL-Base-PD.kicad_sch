	(text "CC1/CC2 are symmetric on a sink: J1 CC1 goes to U1 CC2 and vice versa, so the CC traces need no crossing."
		(exclude_from_sim no)
		(at 50.8 68.58 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "1a03cb38-fdde-53b0-b8c3-da8b459298e4")
	)
	(text "VBUS never exceeds the 20 V contract (+5%): a PD source only applies the voltage the sink requested."
		(exclude_from_sim no)
		(at 50.8 57.15 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "2e7ba322-e846-5d42-9bb6-be08b3aee525")
	)
	(text "and C3 (gate-drain) slows the turn-on to ~3 V/ms, so the head capacitors (~70 uF) charge at ~0.2 A. D2 lights once VOUT is on. F1 fuses everything after J1."
		(exclude_from_sim no)
		(at 50.8 53.34 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "3c5119d4-0f1f-5f21-9122-d86b832c889e")
	)
	(text "D+/D- go to U1 for BC1.2/QC (PD itself only uses CC); A6/B6 and A7/B7 are bridged so both plug orientations work."
		(exclude_from_sim no)
		(at 50.8 64.77 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "6a68d495-7095-5e2b-8231-da6dbd7aa834")
	)
	(text "CH224A asks for 20 V (R1 120k on CFG1). PG is open-drain, 32 V rated, low once the requested voltage is in place."
		(exclude_from_sim no)
		(at 50.8 45.72 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "946a627a-8892-5d9e-b486-cacb2bfbef3b")
	)
	(text "USB-PD base board: 20 V from any PD charger that offers 20 V, switched on only after the contract."
		(exclude_from_sim no)
		(at 50.8 40.64 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "9c0c1009-3757-5f52-ba14-5a16996cfde1")
	)
	(text "Output: J2 pads to the 22 AWG pigtail and DC plug into the centre barrel jack. Head draws ~0.75 A at 20 V."
		(exclude_from_sim no)
		(at 50.8 60.96 0)
		(effects
